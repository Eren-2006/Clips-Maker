# ClipMaster FastAPI Backend Environment Configuration
# Store secrets here or in your deployment secret manager — NEVER hardcode API keys in source code.

# LLM provider for standalone server_ai mode: "gemini" or "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=base

# Pipeline limits & retention
MAX_VIDEO_SECONDS=7200
RETENTION_HOURS=24
OUTPUT_DIR=./outputs
PORT=8000
CORS_ORIGINS=*
